# CONFIGURATION
#
# The entire project is configured using environment variables.
# These variables are utilized by various configuration classes.
# This file documents all available variables.
#
# Python configuration classes covered in this file:
#   • kickstart.engineering.config:KickstartSettings
#
# Copy paste this template in your .env file.
#
# IMPORTANT: Never commit .env files to version control.
#
# To automatically generate .env.example:
#   - Run it manually by using the kickstart CLI
#   - Or configure a pre-commit hook to run the CLI command

# --- KickstartSettings ---
PROJECT_NAME_TO_CHANGE_ROOT=<REQUIRED>  # (str) Root path of your project.
# PROJECT_NAME_TO_CHANGE_ENV=local  # (Env: local, dev, qa, prod) The environment in which the code is running.
# PROJECT_NAME_TO_CHANGE_PROJECT_NAME=None  # (str | None) The installed package name of your project. Used to auto-resolve the version.
# PROJECT_NAME_TO_CHANGE_VERSION=unknown  # (str) Version of the application. Falls back to package metadata if project_name is provided.
# PROJECT_NAME_TO_CHANGE_LOG_LEVEL=INFO  # (Literal: DEBUG, INFO, WARNING, ERROR, CRITICAL) The logging level.
# PROJECT_NAME_TO_CHANGE_USE_JSON_LOGGING=True  # (bool) Whether to use JSON logging.
# PROJECT_NAME_TO_CHANGE_USE_PRETTY_LOG=False  # (bool) Whether to use pretty logging, such as colors. Should be disabled for remote environments.
